# Read by docker-compose.yml and scripts/dev.sh. Copy to .env and replace the placeholder values; the README
# (Configuration) describes every variable.
POSTGRES_PASSWORD=change-me

# At least 32 characters; the server stops at startup otherwise.
JWT_SECRET=change-me-to-a-long-random-string

# Exactly 32 characters; the server stops at startup otherwise. It encrypts CI variables, webhook secrets, the SMTP
# password and TOTP secrets, and it cannot be rotated: changing it makes them unreadable.
SETTINGS_ENCRYPTION_KEY=change-me-32-bytes-exactly-01234

# Where users reach the app in their browser: scheme and host (and port), no path. Required by the server, and it must
# equal the browser's origin for passkeys to work. `http://` is only accepted for localhost.
# docker compose defaults to http://localhost:8080, scripts/dev.sh to http://localhost:4201: leave it commented out
# for those, and set it when the stack is served at another address.
# PUBLIC_URL=http://localhost:8080

# CIDRs of your reverse proxy, comma-separated (for example "10.2.0.0/16,fd00::/8"). Rate limits are per client IP, and
# behind a proxy every request otherwise comes from the proxy's address. Leave empty when the server is reached
# directly. List the proxy only, never a network that untrusted clients can connect from.
TRUSTED_PROXY_CIDRS=

# Creates the first administrator, only while the users table is empty, so they can stay set across restarts. Without
# them there is no way to create the first account. A password shorter than 8 characters skips the bootstrap (logged).
FERRISGIT_BOOTSTRAP_ADMIN_USERNAME=admin
FERRISGIT_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-random-string
