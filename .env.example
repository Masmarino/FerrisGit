# docker-compose.yml reads these — copy to .env and fill in real values before running.
POSTGRES_PASSWORD=change-me
# Must be at least 32 characters long — the server panics on startup otherwise.
JWT_SECRET=change-me-to-a-long-random-string
# Must be EXACTLY 32 characters long — the server panics on startup otherwise.
# Encrypts every repository CI variable at rest.
# WARNING: rotating this key makes every previously-stored CI variable
# permanently undecryptable — there is no re-encryption path. If you change it,
# every CI variable must be re-entered by hand.
SETTINGS_ENCRYPTION_KEY=change-me-32-bytes-exactly-01234
# The public address of the app, as users reach it in their browser: scheme and host (and port if any),
# NO path and no trailing slash needed. Required — the server panics on startup otherwise. Account
# activation links sent by e-mail are built from it (e.g. https://app.example.com/activate#token=...).
# The docker compose stack serves the app on http://localhost:8080; `ng serve` (scripts/dev.sh) uses
# http://localhost:4201 (dev.sh falls back to it when PUBLIC_URL is unset). Passkeys (WebAuthn) require this value
# to equal the origin the BROWSER uses exactly (scheme, host and port): leave it unset for scripts/dev.sh, and
# uncomment/set it when running the docker compose stack behind another address. http:// only works on localhost.
# PUBLIC_URL=http://localhost:8080
# Optional. Comma-separated CIDRs (IPv4 or IPv6, e.g. "10.2.0.0/16,fd00::/8") of YOUR reverse proxy / ingress.
# The login, registration and activation rate limits are per client IP: behind a proxy every request otherwise
# comes from the proxy's address and the whole instance shares ONE budget. For a connection from one of these
# networks the client is the right-most X-Forwarded-For address that is not itself inside them; a connection from
# anywhere else can never choose its own address. IPv6 clients are counted per /64. Leave it empty (the default)
# when the server is reached directly: X-Forwarded-For is then ignored. List the proxy only, never a network
# that untrusted clients can connect from. An invalid value stops the server at startup.
TRUSTED_PROXY_CIDRS=

# Optional: only creates an account when the users table is empty (safe to leave
# set across restarts). Without these, there is no way to create the first admin
# account — the password must be at least 8 characters or bootstrap is skipped
# (logged, not fatal).
FERRISGIT_BOOTSTRAP_ADMIN_USERNAME=admin
FERRISGIT_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-random-string
