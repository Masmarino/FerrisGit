# Read by docker-compose.yml and scripts/dev.sh. Copy to .env and replace the placeholders; the README (Configuration)
# describes every variable.
POSTGRES_PASSWORD=change-me

# At least 32 characters, or the server won't start.
JWT_SECRET=change-me-to-a-long-random-string

# Exactly 32 characters, or the server won't start. It encrypts CI variables, webhook secrets, the SMTP password and TOTP
# secrets, and it can't be rotated: changing it makes them unreadable.
SETTINGS_ENCRYPTION_KEY=change-me-32-bytes-exactly-01234

# Where users reach the app in their browser: scheme, host and port, no path. The server requires it, and it has to match
# the browser's origin or passkeys fail. http:// is only accepted for localhost.
# docker compose defaults to http://localhost:8080 and scripts/dev.sh to http://localhost:4201, so leave it commented out
# for those and set it only when the stack is served somewhere else.
# PUBLIC_URL=http://localhost:8080

# CIDRs of your reverse proxy, comma-separated (for example "10.2.0.0/16,fd00::/8"). Rate limits are per client IP, and
# behind a proxy every request otherwise looks like it comes from the proxy. Leave empty when the server is reached
# directly. List the proxy only, never a network that untrusted clients can connect from.
TRUSTED_PROXY_CIDRS=

# Creates the first administrator, only while the users table is empty, so it's fine to leave them set across restarts.
# Without them there's no way to create the first account. A password under 8 characters skips the bootstrap (it's logged).
FERRISGIT_BOOTSTRAP_ADMIN_USERNAME=admin
FERRISGIT_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-random-string
