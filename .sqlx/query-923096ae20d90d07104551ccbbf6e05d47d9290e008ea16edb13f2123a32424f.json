  "query": "SELECT id, repository_id, number, author_id, assignee_id, milestone_id, title, description, status, kind, parent_issue_id, created_at, closed_at FROM issues WHERE repository_id = ANY($1::uuid[]) AND assignee_id = $2 AND status != 'done' ORDER BY created_at DESC, id LIMIT $3",
