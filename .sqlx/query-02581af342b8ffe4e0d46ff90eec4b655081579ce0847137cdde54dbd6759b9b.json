  "query": "INSERT INTO merge_request_reviews (merge_request_id, user_id, decision, source_sha) VALUES ($1, $2, $3, $4) ON CONFLICT (merge_request_id, user_id) DO UPDATE SET decision = $3, source_sha = $4, created_at = now() RETURNING merge_request_id, user_id, decision, source_sha, created_at, (SELECT username FROM users WHERE id = $2) AS \"username!\"",
