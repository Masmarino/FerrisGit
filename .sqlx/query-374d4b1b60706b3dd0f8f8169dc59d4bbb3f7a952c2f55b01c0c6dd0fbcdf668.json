  "query": "SELECT id, repository_id, number, author_id, assignee_id, milestone_id, title, description, status, kind, parent_issue_id, created_at, closed_at FROM issues WHERE repository_id = ANY($1::uuid[]) AND search_vector @@ websearch_to_tsquery('simple', $2) ORDER BY ts_rank_cd(search_vector, websearch_to_tsquery('simple', $2)) DESC, id LIMIT $3",
