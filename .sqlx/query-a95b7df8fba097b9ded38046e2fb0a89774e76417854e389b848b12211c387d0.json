{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT * FROM jobs\n            WHERE pipeline_id = $1\n              AND status = 'pending'\n              AND NOT EXISTS (\n                  SELECT 1 FROM unnest(needs) AS need_name\n                  WHERE NOT EXISTS (\n                      SELECT 1 FROM jobs j2 WHERE j2.pipeline_id = jobs.pipeline_id AND j2.name = need_name AND j2.status = 'success'\n                  )\n              )\n            ORDER BY created_at\n            ",
